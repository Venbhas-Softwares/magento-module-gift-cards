<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_product_add_before">
        <observer name="venbhas_giftcard_validate_fields" instance="Venbhas\GiftCard\Observer\ValidateGiftCardFieldsOnAddToCart"/>
    </event>
    <event name="checkout_cart_product_add_after">
        <!-- Order is document order: persist additional_options first, then apply custom price. -->
        <observer name="venbhas_giftcard_persist_fields" instance="Venbhas\GiftCard\Observer\PersistGiftCardFieldsOnQuoteItem"/>
        <observer name="venbhas_giftcard_apply_amount" instance="Venbhas\GiftCard\Observer\ApplyGiftCardAmountToQuoteItem"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="venbhas_giftcard_convert_quote_order" instance="Venbhas\GiftCard\Observer\ConvertQuoteToOrder"/>
    </event>
    <!-- Ensure order has entity_id/items saved before reserving giftcard rows -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="venbhas_giftcard_log_checkout_usage_on_quote_submit_success"
                  instance="Venbhas\GiftCard\Observer\LogGiftCardCheckoutUsageOnOrderPlace"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="venbhas_giftcard_log_checkout_usage_on_order_place"
                  instance="Venbhas\GiftCard\Observer\LogGiftCardCheckoutUsageOnOrderPlace"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="venbhas_giftcard_generate_on_invoice" instance="Venbhas\GiftCard\Observer\GenerateGiftCardOnInvoicePay"/>
    </event>

    <!-- Wallet credit-back on cancel / refund -->
    <event name="sales_order_cancel_after">
        <observer name="venbhas_giftcard_wallet_credit_on_cancel" instance="Venbhas\GiftCard\Observer\CreditWalletOnOrderCancel"/>
    </event>
    <event name="sales_order_creditmemo_save_before">
        <observer name="venbhas_giftcard_block_refund_if_redeemed" instance="Venbhas\GiftCard\Observer\PreventGiftCardRefundIfRedeemed"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="venbhas_giftcard_wallet_credit_on_refund" instance="Venbhas\GiftCard\Observer\CreditWalletOnCreditmemoRefund"/>
    </event>
</config>

