<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Register in global di.xml so array merges with core; adminhtml/di.xml would replace the whole collections map. -->
    <virtualType name="Venbhas\GiftCard\Ui\DataProvider\GiftCardCode\Listing\Collection"
                 type="Venbhas\GiftCard\Model\ResourceModel\GiftCardCode\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">venbhas_giftcard_code</argument>
            <argument name="eventPrefix" xsi:type="string">venbhas_giftcard_code_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">giftcard_code_collection</argument>
            <argument name="resourceModel" xsi:type="string">Venbhas\GiftCard\Model\ResourceModel\GiftCardCode</argument>
        </arguments>
    </virtualType>
    <virtualType name="Venbhas\GiftCard\Ui\DataProvider\GiftCardTransaction\Listing\Collection"
                 type="Venbhas\GiftCard\Model\ResourceModel\GiftCardTransaction\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">venbhas_giftcard_transaction</argument>
            <argument name="eventPrefix" xsi:type="string">venbhas_giftcard_transaction_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">giftcard_transaction_collection</argument>
            <argument name="resourceModel" xsi:type="string">Venbhas\GiftCard\Model\ResourceModel\GiftCardTransaction</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="venbhas_giftcard_code_listing_data_source" xsi:type="string">Venbhas\GiftCard\Ui\DataProvider\GiftCardCode\Listing\Collection</item>
                <item name="venbhas_giftcard_transaction_listing_data_source" xsi:type="string">Venbhas\GiftCard\Ui\DataProvider\GiftCardTransaction\Listing\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Venbhas\GiftCard\Model\Product\Type\GiftCard">
        <arguments>
            <argument name="giftOptionsResolver" xsi:type="object">Venbhas\GiftCard\Model\Product\GiftOptionsResolver</argument>
        </arguments>
    </type>
    <type name="Magento\Quote\Api\CartTotalRepositoryInterface">
        <plugin name="venbhas_giftcard_totals_extension"
                type="Venbhas\GiftCard\Plugin\Quote\CartTotalRepositoryPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem">
        <plugin name="venbhas_giftcard_quote_item_additional_options_to_order_item"
                type="Venbhas\GiftCard\Plugin\Quote\Item\ToOrderItemPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\Sales\Block\Order\Totals">
        <plugin name="venbhas_giftcard_sales_totals"
                type="Venbhas\GiftCard\Plugin\Sales\Order\TotalsPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\Sales\Block\Order\Email\Shipment\Items">
        <plugin name="venbhas_giftcard_shipment_email_totals"
                type="Venbhas\GiftCard\Plugin\Sales\Order\Email\ShipmentItemsPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\Sales\Block\Order\PrintOrder\Shipment">
        <plugin name="venbhas_giftcard_print_shipment_totals"
                type="Venbhas\GiftCard\Plugin\Sales\Order\PrintShipmentPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\Shipping\Block\Adminhtml\View\Form">
        <plugin name="venbhas_giftcard_admin_shipment_order_totals"
                type="Venbhas\GiftCard\Plugin\Shipping\Adminhtml\View\FormPlugin"
                sortOrder="100"/>
    </type>

    <type name="Magento\Catalog\Model\Product\Type">
        <plugin name="venbhas_giftcard_hide_product_type_when_disabled"
                type="Venbhas\GiftCard\Plugin\Catalog\Product\TypePlugin"
                sortOrder="10"/>
    </type>

    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="venbhas_giftcard_exclude_products_when_disabled"
                type="Venbhas\GiftCard\Plugin\Catalog\Product\Collection\ExcludeGiftCardProductsPlugin"
                sortOrder="10"/>
    </type>
</config>
