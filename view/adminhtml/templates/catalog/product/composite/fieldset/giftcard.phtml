$escapedCurrency = $escaper->escapeJs($currencySymbol);
$scriptString = <<<SCRIPT
require(['jquery'], function ($) {
    'use strict';

    var amountSelect = $('#venbhas_giftcard_amount_select'),
        amountInput = $('#venbhas_giftcard_amount'),
        priceDisplay = $('#venbhas_giftcard_price_display'),
        deliverySelect = $('#venbhas_giftcard_delivery_type'),
        addressWrap = $('#venbhas_giftcard_address_wrap'),
        currencySymbol = '{$escapedCurrency}';

    function formatPrice(amount) {
        return currencySymbol + parseFloat(amount).toFixed(2);
    }

    function updatePriceDisplay(amount) {
        amount = parseFloat(amount);
        if (isNaN(amount) || amount <= 0) {
            return;
        }
        priceDisplay.text(formatPrice(amount));
    }

    function syncSelectToInput() {
        if (!amountSelect.length || !amountInput.length) {
            return;
        }
        var currentVal = amountInput.val();
        if (!currentVal) {
            return;
        }
        var found = false;
        amountSelect.find('option').each(function () {
            if ($(this).val() !== 'custom' && parseFloat($(this).val()) === parseFloat(currentVal)) {
                found = true;
                amountSelect.val($(this).val());
                amountInput.attr('type', 'hidden').hide();
                return false;
            }
        });
        if (!found && amountSelect.find('option[value="custom"]').length) {
            amountSelect.val('custom');
            amountInput.attr('type', 'number').show();
        }
    }

    if (amountSelect.length) {
        amountSelect.on('change', function () {
            var val = $(this).val();
            if (val === 'custom') {
                amountInput.attr('type', 'number').show().val('').trigger('focus');
            } else {
                amountInput.attr('type', 'hidden').hide().val(val);
                updatePriceDisplay(val);
            }
        });
        syncSelectToInput();
        if (amountSelect.val() && amountSelect.val() !== 'custom') {
            amountInput.val(amountSelect.val());
        }
    }

    amountInput.on('change input', function () {
        var v = parseFloat($(this).val());
        if (!isNaN(v) && v > 0) {
            updatePriceDisplay(v);
        }
    });

    if (amountInput.val()) {
        updatePriceDisplay(amountInput.val());
    }

    if (deliverySelect.length && addressWrap.length) {
        deliverySelect.on('change', function () {
            var isPhysical = ($(this).val() === 'physical');
            if (isPhysical) {
                addressWrap.show();
                addressWrap.find('input').prop('disabled', false).addClass('required-entry');
            } else {
                addressWrap.hide();
                addressWrap.find('input').prop('disabled', true).removeClass('required-entry').val('');
            }
        });
        deliverySelect.trigger('change');
    }
});
SCRIPT;
