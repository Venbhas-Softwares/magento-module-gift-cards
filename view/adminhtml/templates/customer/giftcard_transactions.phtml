<?php
/** @var \Venbhas\GiftCard\Block\Adminhtml\Customer\Edit\Tab\GiftCardTransactions $block */
$rows = $block->getTransactions();
$walletBalance = (float) $block->getWalletBalance();
?>
<div class="admin__data-grid-wrap">
    <?php if (!$rows): ?>
        <p><?= $escaper->escapeHtml(__('No gift card transactions recorded for this customer.')) ?></p>
    <?php else: ?>
        <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom: 10px;">
            <strong><?= $escaper->escapeHtml(__('Gift card usage history')) ?></strong>
            <div style="text-align:right;">
                <div style="font-weight:600;"><?= $escaper->escapeHtml(__('Gift Amount')) ?></div>
                <div style="font-size: 16px; font-weight: 700;">
                    <?= $escaper->escapeHtml($block->formatAmount($walletBalance, null)) ?>
                </div>
            </div>
        </div>
        <table class="admin__table-secondary">
            <thead>
            <tr>
                <th><?= $escaper->escapeHtml(__('Created At')) ?></th>
                <th><?= $escaper->escapeHtml(__('Transaction Type')) ?></th>
                <th><?= $escaper->escapeHtml(__('Description')) ?></th>
                <th><?= $escaper->escapeHtml(__('Order')) ?></th>
                <th><?= $escaper->escapeHtml(__('Gift card code')) ?></th>
                <th><?= $escaper->escapeHtml(__('Amount')) ?></th>
                <th><?= $escaper->escapeHtml(__('Previous Balance')) ?></th>
                <th><?= $escaper->escapeHtml(__('Current Balance')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($rows as $trx): ?>
                <?php
                $orderId = (int) $trx->getData('order_id');
                $incrementId = (string) $trx->getData('increment_id');
                $code = (string) $trx->getData('giftcard_code');
                $type = (string) $trx->getData('transaction_type');
                $amount = (float) $trx->getData('amount');
                ?>
                <tr>
                    <td><?= $escaper->escapeHtml($block->formatCreatedAt($trx->getData('created_at'))) ?></td>
                    <td><?= $escaper->escapeHtml($block->getActionLabel($trx)) ?></td>
                    <td>
                        <?php
                        $desc = str_replace('_', ' ', trim((string) $trx->getData('description')));
                        if ($desc !== '') {
                            $desc = mb_strtolower($desc);
                            $desc = mb_strtoupper(mb_substr($desc, 0, 1)) . mb_substr($desc, 1);
                        }
                        ?>
                        <?= $escaper->escapeHtml($desc) ?>
                    </td>
                    <td>
                        <?php if ($orderId && $incrementId !== ''): ?>
                            <a href="<?= $escaper->escapeUrl($block->getAdminOrderUrl($orderId)) ?>">
                                <?= $escaper->escapeHtml($incrementId) ?>
                            </a>
                        <?php else: ?>
                            <?= $escaper->escapeHtml(__('—')) ?>
                        <?php endif; ?>
                    </td>
                    <td><?= $escaper->escapeHtml($code) ?></td>
                    <td>
                        <?php
                        $formattedAmount = $block->formatAmount($amount, null);
                        if ($amount <= 0.0001) {
                            echo $escaper->escapeHtml($formattedAmount);
                        } else {
                            $sign = '+';
                            if ($type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_DEBIT
                                || $type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_CHECKOUT_APPLY
                                || $type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_REDEEM
                            ) {
                                $sign = '-';
                            }
                            $signClass = $sign === '+' ? 'venbhas-gc-sign--plus' : 'venbhas-gc-sign--minus';
                            ?>
                            <span class="venbhas-gc-sign <?= $escaper->escapeHtmlAttr($signClass) ?>">
                                <?= $escaper->escapeHtml('[' . $sign . ']') ?>
                            </span>
                            <?= $escaper->escapeHtml($formattedAmount) ?>
                        <?php } ?>
                    </td>   
                    <td>
                        <?php $prevBal = (float) $trx->getData('previous_balance'); ?>
                        <?= $escaper->escapeHtml($block->formatAmount($prevBal, null)) ?>
                    </td>
                    <td>
                        <?php $curBal = (float) $trx->getData('current_balance'); ?>
                        <?= $escaper->escapeHtml($block->formatAmount($curBal, null)) ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
