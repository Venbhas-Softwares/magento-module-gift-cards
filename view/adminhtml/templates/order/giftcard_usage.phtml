<?php
/** @var \Venbhas\GiftCard\Block\Order\GiftCardUsage $block */
if (!$block->shouldDisplay()) {
    return;
}
$rows = $block->getUsageRows();
$order = $block->getOrder();
$totalApplied = $order ? (float) $order->getData('venbhas_giftcard_amount') : 0.0;
?>
<div class="admin__page-section-item order-giftcard-usage" style="margin-top:12px;">
    <div class="admin__page-section-item-title">
        <span class="title"><?= $block->escapeHtml(__('Gift card')) ?></span>
    </div>
    <div class="admin__page-section-item-content">
        <p><?= $block->escapeHtml(__('Total applied from gift cards: %1', $block->formatAmount($totalApplied))) ?></p>
        <?php if ($rows): ?>
            <table class="admin__table-secondary">
                <thead>
                <tr>
                    <th><?= $block->escapeHtml(__('Code')) ?></th>
                    <th><?= $block->escapeHtml(__('Amount used')) ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <td><?= $block->escapeHtml($row['code']) ?></td>
                        <td><?= $block->escapeHtml($block->formatAmount((float) $row['amount'])) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </div>
</div>
