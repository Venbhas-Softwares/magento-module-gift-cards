<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">venbhas_giftcard_code_listing.venbhas_giftcard_code_listing_data_source</item>
            <item name="deps" xsi:type="string">venbhas_giftcard_code_listing.venbhas_giftcard_code_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">listing_columns</item>
    </argument>

    <dataSource name="venbhas_giftcard_code_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">venbhas_giftcard_code_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>

    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">venbhas_giftcard_code_listing.venbhas_giftcard_code_listing.listing_columns.ids</item>
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
            <action name="activate">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">activate</item>
                        <item name="label" xsi:type="string" translate="true">Activate</item>
                        <item name="url" xsi:type="url" path="venbhas_giftcard/code/massStatus">
                            <param name="status">1</param>
                        </item>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Activate</item>
                            <item name="message" xsi:type="string" translate="true">Activate selected gift card codes?</item>
                        </item>
                    </item>
                </argument>
            </action>
            <action name="deactivate">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">deactivate</item>
                        <item name="label" xsi:type="string" translate="true">Deactivate</item>
                        <item name="url" xsi:type="url" path="venbhas_giftcard/code/massStatus">
                            <param name="status">0</param>
                        </item>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Deactivate</item>
                            <item name="message" xsi:type="string" translate="true">Deactivate selected gift card codes?</item>
                        </item>
                    </item>
                </argument>
            </action>
        </massaction>
        <paging name="listing_paging"/>
        <filters name="listing_filters"/>
    </listingToolbar>

    <columns name="listing_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="code">
            <settings>
                <filter>text</filter>
                <label translate="true">Code</label>
            </settings>
        </column>
        <column name="amount" class="Venbhas\GiftCard\Ui\Component\Listing\Column\AdminPrice">
            <settings>
                <filter>textRange</filter>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Amount</label>
            </settings>
        </column>
        <column name="is_reedemed" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Redeemed</label>
                <options class="Venbhas\GiftCard\Model\Source\GiftCardStatus"/>
            </settings>
        </column>
        <column name="recipient_email">
            <settings>
                <filter>text</filter>
                <label translate="true">Recipient Email</label>
            </settings>
        </column>
        <column name="order_id" class="Venbhas\GiftCard\Ui\Component\Listing\Column\AdminOrderLink">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
        <column name="created_at">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="store_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Store ID</label>
            </settings>
        </column>
    </columns>
</listing>

