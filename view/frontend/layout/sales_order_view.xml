<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_totals">
            <block class="Venbhas\GiftCard\Block\Order\Totals\GiftCard" name="venbhas.giftcard.order.totals" />
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Venbhas\GiftCard\Block\Order\GiftCardUsage"
                   name="venbhas.order.giftcard.usage"
                   template="Venbhas_GiftCard::order/giftcard_usage.phtml"
                   after="sales.order.view"/>
        </referenceContainer>
    </body>
</page>

