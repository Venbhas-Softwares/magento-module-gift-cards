<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="venbhas_giftcard" xsi:type="array">
                                    <item name="component" xsi:type="string">Venbhas_GiftCard/js/view/checkout/cart/totals</item>
                                    <item name="sortOrder" xsi:type="string">65</item>
                                    <item name="config" xsi:type="array">
                                        <item name="template" xsi:type="string">Venbhas_GiftCard/checkout/cart/giftcard</item>
                                        <item name="title" xsi:type="helper"
                                              helper="Venbhas\GiftCard\Model\Config::getTotalTitle"/>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="checkout.cart.coupon">
            <block class="Venbhas\GiftCard\Block\Cart\GiftCard" name="venbhas.giftcard.cart" template="Venbhas_GiftCard::cart/giftcard.phtml" after="-"/>
        </referenceBlock>
    </body>
</page>
