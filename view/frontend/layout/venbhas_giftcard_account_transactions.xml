<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Venbhas\GiftCard\Block\Account\GiftCardTransactions"
                   name="venbhas.giftcard.account.transactions"
                   template="Venbhas_GiftCard::account/transactions.phtml"
                   ifconfig="venbhas_giftcard/general/enabled"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
