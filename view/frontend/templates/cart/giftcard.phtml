<?php
/** @var \Venbhas\GiftCard\Block\Cart\GiftCard $block */
$codes = $block->getCodes();
?>
<div class="cart-discount giftcard-discount">
    <div class="title">
        <strong id="block-giftcard-heading" role="heading" aria-level="2">
            <?= $escaper->escapeHtml(__('Gift Card')) ?>
        </strong>
    </div>
    <div class="content" aria-labelledby="block-giftcard-heading">
        <form class="form giftcard"
              action="<?= $escaper->escapeUrl($block->getUrl('venbhas_giftcard/cart/apply')) ?>"
              method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <div class="fieldset coupon">
                <div class="field">
                    <label class="label" for="giftcard_code">
                        <span><?= $escaper->escapeHtml(__('Enter gift card code')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text" class="input-text" id="giftcard_code" name="giftcard_code" value="" />
                    </div>
                </div>
                <div class="actions-toolbar">
                    <div class="primary">
                        <button class="action apply primary" type="submit">
                            <span><?= $escaper->escapeHtml(__('Apply')) ?></span>
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <?php if ($codes): ?>
            <div class="applied-giftcards" style="margin-top:12px;">
                <strong><?= $escaper->escapeHtml(__('Applied gift cards')) ?>:</strong>
                <ul class="items">
                    <?php foreach ($codes as $code): ?>
                        <li class="item">
                            <span><?= $escaper->escapeHtml($code) ?></span>
                            <form style="display:inline"
                                  action="<?= $escaper->escapeUrl($block->getUrl('venbhas_giftcard/cart/remove')) ?>"
                                  method="post">
                                <?= $block->getBlockHtml('formkey') ?>
                                <input type="hidden"
                                       name="giftcard_code"
                                       value="<?= $escaper->escapeHtmlAttr($code) ?>" />
                                <button type="submit" class="action remove">
                                    <span><?= $escaper->escapeHtml(__('Remove')) ?></span>
                                </button>
                            </form>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
        <?php endif; ?>
    </div>
