<?php
/**
 * Hyvä-compatible pager for gift card transactions (no Luma pager CSS/JS).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Venbhas\GiftCard\Block\Account\GiftCardTransactions $accountBlock
 */
$accountBlock = $block->getData('account_block');
if (!$accountBlock) {
    return;
}

$total = $accountBlock->getPagerTotalNum();
if ($total <= 0) {
    return;
}

$lastPage = $accountBlock->getPagerLastPageNum();
$currentPage = $accountBlock->getPagerCurrentPage();
$pages = $accountBlock->getPagerPages();
?>
<nav class="venbhas-gc-pager" aria-label="<?= $escaper->escapeHtmlAttr(__('Gift card transactions pagination')) ?>">
    <p class="venbhas-gc-pager__amount">
        <?php if ($lastPage > 1): ?>
            <?= $escaper->escapeHtml(
                __(
                    'Items %1 to %2 of %3 total',
                    $accountBlock->getPagerFirstNum(),
                    $accountBlock->getPagerLastNum(),
                    $total
                )
            ) ?>
        <?php else: ?>
            <?= $escaper->escapeHtml(
                $total === 1
                    ? __('%1 Item', $total)
                    : __('%1 Item(s)', $total)
            ) ?>
        <?php endif; ?>
    </p>

    <?php if ($lastPage > 1): ?>
        <ul class="venbhas-gc-pager__pages">
            <?php if (!$accountBlock->isPagerFirstPage()): ?>
                <li>
                    <a class="venbhas-gc-pager__link"
                       href="<?= $escaper->escapeUrl($accountBlock->getPagerPreviousPageUrl()) ?>">
                        <?= $escaper->escapeHtml(__('Previous')) ?>
                    </a>
                </li>
            <?php endif; ?>

            <?php foreach ($pages as $page): ?>
                <li>
                    <?php if ($page === $currentPage): ?>
                        <span class="venbhas-gc-pager__current" aria-current="page">
                            <?= $escaper->escapeHtml((string) $page) ?>
                        </span>
                    <?php else: ?>
                        <a class="venbhas-gc-pager__link"
                           href="<?= $escaper->escapeUrl($accountBlock->getPagerPageUrl((int) $page)) ?>">
                            <?= $escaper->escapeHtml((string) $page) ?>
                        </a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>

            <?php if (!$accountBlock->isPagerLastPage()): ?>
                <li>
                    <a class="venbhas-gc-pager__link"
                       href="<?= $escaper->escapeUrl($accountBlock->getPagerNextPageUrl()) ?>">
                        <?= $escaper->escapeHtml(__('Next')) ?>
                    </a>
                </li>
            <?php endif; ?>
        </ul>
    <?php endif; ?>

    <?php if ($accountBlock->showPagerLimitOptions()): ?>
        <div class="venbhas-gc-pager__limiter">
            <label class="venbhas-gc-pager__limiter-label" for="venbhas-gc-pager-limit">
                <?= $escaper->escapeHtml(__('Show')) ?>
            </label>
            <select id="venbhas-gc-pager-limit"
                    class="venbhas-gc-pager__limiter-select"
                    onchange="window.location.href=this.value">
                <?php foreach ($accountBlock->getAvailablePageLimits() as $limit): ?>
                    <option value="<?= $escaper->escapeUrl($accountBlock->getPagerLimitUrl($limit)) ?>"
                        <?php if ($accountBlock->isPagerLimitCurrent($limit)): ?>selected="selected"<?php endif; ?>>
                        <?= $escaper->escapeHtml((string) $limit) ?>
                    </option>
                <?php endforeach; ?>
            </select>
            <span class="venbhas-gc-pager__limiter-text"><?= $escaper->escapeHtml(__('per page')) ?></span>
        </div>
    <?php endif; ?>
</nav>
