<?php
/** @var \Venbhas\GiftCard\Block\Account\MyGiftCards $block */
$cards = $block->getGiftCards();
?>
<div class="venbhas-giftcards-account">
    <div class="page-title-wrapper">
        <h1 class="page-title"><span class="base"><?= $escaper->escapeHtml(__('My Gift Cards')) ?></span></h1>
    </div>

    <?php if (!$cards->getSize()): ?>
        <div class="message info empty">
            <span><?= $escaper->escapeHtml(__('You have no gift cards yet.')) ?></span>
        </div>
    <?php else: ?>
        <div class="table-wrapper orders-history">
            <table class="data table table-giftcards" id="my-giftcards-table">
                <caption class="table-caption"><?= $escaper->escapeHtml(__('Gift cards')) ?></caption>
                <thead>
                <tr>
                    <th scope="col"><?= $escaper->escapeHtml(__('Gift card code')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Status')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Amount')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Balance')) ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($cards as $card): ?>
                    <?php
                    $currency = (string) $card->getData('currency_code');
                    $initial = $block->getInitialValue($card);
                    $balance = $block->getBalanceValue($card);
                    ?>
                    <tr>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Gift card code')) ?>">
                            <?= $escaper->escapeHtml((string) $card->getData('code')) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Status')) ?>">
                            <?= $escaper->escapeHtml((string) $block->getStatusLabel($card)) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Initial amount')) ?>">
                            <?= $escaper->escapeHtml($block->formatMoney($initial, $currency)) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Current balance')) ?>">
                            <?= $escaper->escapeHtml($block->formatMoney($balance, $currency)) ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
