<?php
/** @var \Venbhas\GiftCard\Block\Account\GiftCardTransactions $block */
$collection = $block->getTransactionsCollection();
$rows = $block->getTransactions();
$walletBalance = (float) $block->getWalletBalance();
$hasTransactions = (int) $collection->getSize() > 0;
?>
<div class="block block-giftcard-transactions">
    <div class="block-title">
        <strong><?= $escaper->escapeHtml(__('Gift card usage history')) ?></strong>
    </div>
    <div class="block-content">
        <p class="giftcard-wallet-balance">
            <strong><?= $escaper->escapeHtml(__('Gift Amount')) ?>:</strong>
            <?= $escaper->escapeHtml($block->formatAmount($walletBalance, null)) ?>
        </p>

        <div class="actions-toolbar">
            <div class="primary">
                <button type="button" class="action primary" id="venbhas-add-giftcard-btn">
                    <?= $escaper->escapeHtml(__('Add a new gift card')) ?>
                </button>
            </div>
        </div>

        <div id="venbhas-add-giftcard-modal" style="display:none">
            <div class="field">
                <label for="venbhas-giftcard-code" class="label">
                    <span><?= $escaper->escapeHtml(__('Gift card code')) ?></span>
                </label>
                <div class="control">
                    <input type="text" id="venbhas-giftcard-code" class="input-text" />
                </div>
            </div>
        </div>

        <script type="text/x-magento-init">
        {
            "*": {
                "Venbhas_GiftCard/js/account/add-giftcard": {
                    "modalSelector": "#venbhas-add-giftcard-modal",
                    "buttonSelector": "#venbhas-add-giftcard-btn",
                    "inputSelector": "#venbhas-giftcard-code",
                    "postUrl": "<?= $escaper->escapeJs($block->getAddGiftcardUrl()) ?>",
                    "formKey": "<?= $escaper->escapeJs($block->getFormKeyValue()) ?>"
                }
            }
        }
        </script>

        <?php if (!$hasTransactions): ?>
            <p><?= $escaper->escapeHtml(__('You have no gift card transactions yet.')) ?></p>
        <?php else: ?>
            <div class="table-wrapper">
                <table class="data table" id="giftcard-transactions-table">
                    <caption class="table-caption"><?= $escaper->escapeHtml(__('Gift card transactions')) ?></caption>
                    <thead>
                    <tr>
                        <th scope="col"><?= $escaper->escapeHtml(__('Date')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Description')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Amount')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Previous Balance')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Current Balance')) ?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($rows as $trx): ?>
                        <?php
                        $amount = (float) $trx->getData('amount');
                        $desc = str_replace('_', ' ', trim((string) $trx->getData('description')));
                        if ($desc !== '') {
                            $desc = mb_strtolower($desc);
                            $desc = mb_strtoupper(mb_substr($desc, 0, 1)) . mb_substr($desc, 1);
                        }
                        ?>
                        <tr>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Date')) ?>">
                                <?php
                                $createdAt = (string) $trx->getData('created_at');
                                ?>
                                <?= $escaper->escapeHtml(
                                    $createdAt !== ''
                                        ? $block->formatDate($createdAt, \IntlDateFormatter::MEDIUM, true)
                                        : '—'
                                ) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Description')) ?>">
                                <?= $escaper->escapeHtml($desc) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Amount')) ?>">
                                <?php
                                $formattedAmount = $block->formatAmount($amount, null);
                                if ($amount <= 0.0001) {
                                    echo $escaper->escapeHtml($formattedAmount);
                                } else {
                                    $sign = \Venbhas\GiftCard\Model\GiftCardTransaction::isDebit(
                                        $trx->getData('transaction_type'),
                                        (string) $trx->getData('description')
                                    ) ? '-' : '+';
                                    $signClass = $sign === '+' ? 'venbhas-gc-sign--plus' : 'venbhas-gc-sign--minus';
                                    echo '<span class="venbhas-gc-sign ' . $escaper->escapeHtmlAttr($signClass) . '">'
                                        . $escaper->escapeHtml('[' . $sign . ']')
                                        . '</span>&nbsp;'
                                        . $escaper->escapeHtml($formattedAmount);
                                }
                                ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Previous Balance')) ?>">
                                <?= $escaper->escapeHtml(
                                    $block->formatAmount((float) $trx->getData('previous_balance'), null)
                                ) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Current Balance')) ?>">
                                <?= $escaper->escapeHtml(
                                    $block->formatAmount((float) $trx->getData('current_balance'), null)
                                ) ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <?php if ($block->getPagerHtml()): ?>
                <div class="giftcard-transactions-toolbar toolbar bottom">
                    <?= $block->getPagerHtml() ?>
                </div>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</div>
