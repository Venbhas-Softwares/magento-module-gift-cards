<?php
/** @var \Venbhas\GiftCard\Block\Account\GiftCardTransactions $block */
$rows = $block->getTransactions();
$walletBalance = (float) $block->getWalletBalance();
?>
<div class="block block-giftcard-transactions">
    <style>
        /* Scoped fallback styles for themes without Luma table CSS (e.g. Hyvä). */
        .block-giftcard-transactions .table-wrapper { overflow-x: auto; }
        .block-giftcard-transactions table.data.table { width: 100%; border-collapse: collapse; }
        .block-giftcard-transactions table.data.table caption { text-align: left; font-weight: 600; padding: .5rem 0; }
        .block-giftcard-transactions table.data.table th,
        .block-giftcard-transactions table.data.table td {
            padding: .75rem .5rem;
            border-bottom: 1px solid rgba(0,0,0,.08);
            text-align: left;
            vertical-align: top;
        }
        .block-giftcard-transactions table.data.table thead th { white-space: nowrap; }
        .block-giftcard-transactions .block-title strong { font-size: 1.1rem; }
        .block-giftcard-transactions .header-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
        }
        .block-giftcard-transactions .wallet { text-align: right; white-space: nowrap; }
        .block-giftcard-transactions .wallet .label { display: block; font-weight: 600; }
        .block-giftcard-transactions .wallet .value { display: block; font-size: 1.2rem; font-weight: 700; }

        /* Match admin grid signed-amount badge. */
        .block-giftcard-transactions .venbhas-gc-sign { font-weight: 700; }
        .block-giftcard-transactions .venbhas-gc-sign--plus { color: #008a00; }
        .block-giftcard-transactions .venbhas-gc-sign--minus { color: #d20000; }
        .block-giftcard-transactions .venbhas-gc-sign { display: inline-block; }

        /* Keep code/amount on one line like admin grid. */
        .block-giftcard-transactions td.col-giftcard-code,
        .block-giftcard-transactions td.col-amount { white-space: nowrap; }
        .block-giftcard-transactions td.col-giftcard-code { overflow-wrap: normal; word-break: keep-all; }
    </style>
    <div class="block-title header-row">
        <strong><?= $escaper->escapeHtml(__('Gift card usage history')) ?></strong>
        <div class="wallet">
            <span class="label"><?= $escaper->escapeHtml(__('Gift Amount')) ?></span>
            <span class="value">
                <?= $escaper->escapeHtml($block->formatAmount($walletBalance, null)) ?>
            </span>
        </div>
    </div>
    <div class="block-content">
        <div style="margin: .75rem 0;">
            <button type="button" class="action primary" id="venbhas-add-giftcard-btn">
                <?= $escaper->escapeHtml(__('Add a new gift card')) ?>
            </button>
        </div>

        <div id="venbhas-add-giftcard-modal" style="display:none">
            <div class="field">
                <label for="venbhas-giftcard-code" class="label">
                    <span><?= $escaper->escapeHtml(__('Gift card code')) ?></span>
                </label>
                <div class="control">
                    <input type="text" id="venbhas-giftcard-code" class="input-text" />
                </div>
            </div>
        </div>

        <script type="text/x-magento-init">
        {
            "*": {
                "Venbhas_GiftCard/js/account/add-giftcard": {
                    "modalSelector": "#venbhas-add-giftcard-modal",
                    "buttonSelector": "#venbhas-add-giftcard-btn",
                    "inputSelector": "#venbhas-giftcard-code",
                    "postUrl": "<?= $escaper->escapeJs($block->getAddGiftcardUrl()) ?>",
                    "formKey": "<?= $escaper->escapeJs($block->getFormKeyValue()) ?>"
                }
            }
        }
        </script>

        <?php if (!$rows): ?>
            <p><?= $escaper->escapeHtml(__('You have no gift card transactions yet.')) ?></p>
        <?php else: ?>
            <div class="table-wrapper">
                <table class="data table" id="giftcard-transactions-table">
                    <caption class="table-caption"><?= $escaper->escapeHtml(__('Gift card transactions')) ?></caption>
                    <thead>
                    <tr>
                        <th scope="col"><?= $escaper->escapeHtml(__('Date')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Transaction Type')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Description')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Order')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Gift card code')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Amount')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Previous Balance')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('Current Balance')) ?></th>
                        
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($rows as $trx): ?>
                        <?php
                        $orderId = (int) $trx->getData('order_id');
                        $incrementId = (string) $trx->getData('increment_id');
                        $code = (string) $trx->getData('giftcard_code');
                        $type = (string) $trx->getData('transaction_type');
                        $amount = (float) $trx->getData('amount');

                        $transactionType = str_replace('_', ' ', trim($type));
                        if ($transactionType !== '') {
                            $transactionType = mb_strtolower($transactionType);
                            $transactionType = mb_strtoupper(mb_substr($transactionType, 0, 1)) . mb_substr($transactionType, 1);
                        }

                        $desc = str_replace('_', ' ', trim((string) $trx->getData('description')));
                        if ($desc !== '') {
                            $desc = mb_strtolower($desc);
                            $desc = mb_strtoupper(mb_substr($desc, 0, 1)) . mb_substr($desc, 1);
                        }
                        ?>
                        <tr>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Date')) ?>">
                                <?php
                                $createdAt = (string) $trx->getData('created_at');
                                ?>
                                <?= $escaper->escapeHtml(
                                    $createdAt !== ''
                                        ? $block->formatDate($createdAt, \IntlDateFormatter::MEDIUM, true)
                                        : '—'
                                ) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Transaction Type')) ?>">
                                <?= $escaper->escapeHtml($transactionType) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Description')) ?>">
                                <?= $escaper->escapeHtml($desc) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Order')) ?>">
                                <?php if ($orderId && $incrementId !== ''): ?>
                                    <a href="<?= $escaper->escapeUrl($block->getOrderViewUrl($orderId)) ?>">
                                        <?= $escaper->escapeHtml($incrementId) ?>
                                    </a>
                                <?php else: ?>
                                    <?= $escaper->escapeHtml(__('—')) ?>
                                <?php endif; ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Gift card code')) ?>" class="col-giftcard-code">
                                <?= $escaper->escapeHtml($code) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Amount')) ?>" class="col-amount">
                                <?php
                                $formattedAmount = $block->formatAmount($amount, null);
                                if ($amount <= 0.0001) {
                                    echo $escaper->escapeHtml($formattedAmount);
                                } else {
                                    $sign = '+';
                                    if ($type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_DEBIT
                                        || $type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_CHECKOUT_APPLY
                                        || $type === \Venbhas\GiftCard\Model\GiftCardTransaction::ACTION_REDEEM
                                    ) {
                                        $sign = '-';
                                    }
                                    $signClass = $sign === '+' ? 'venbhas-gc-sign--plus' : 'venbhas-gc-sign--minus';
                                    echo '<span class="venbhas-gc-sign ' . $escaper->escapeHtmlAttr($signClass) . '">'
                                        . $escaper->escapeHtml('[' . $sign . ']')
                                        . '</span>&nbsp;'
                                        . $escaper->escapeHtml($formattedAmount);
                                }
                                ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Previous Balance')) ?>">
                                <?= $escaper->escapeHtml(
                                    $block->formatAmount((float) $trx->getData('previous_balance'), null)
                                ) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Current Balance')) ?>">
                                <?= $escaper->escapeHtml(
                                    $block->formatAmount((float) $trx->getData('current_balance'), null)
                                ) ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </div>
</div>
