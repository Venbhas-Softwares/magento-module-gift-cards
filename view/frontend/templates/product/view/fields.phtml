<script>
require(['jquery', 'jquery-ui-modules/widget', 'Magento_Directory/js/region-updater'], function ($) {
    'use strict';
    var $form = $('#product_addtocart_form');
    if (!$form.length) {
        return;
    }
    var $hidden = $('#venbhas_giftcard_amount');
    var $wrap = $form.find('.venbhas-giftcard-amounts');
    if (!$wrap.length) {
        return;
    }
    var $otherWrap = $wrap.find('.venbhas-giftcard-other-wrap');
    var $otherInput = $wrap.find('.venbhas-giftcard-other-input');
    var min = <?= (float)$block->getMinAmount() ?>;
    var max = <?= (float)$block->getMaxAmount() ?>;
    var allowCustom = <?= $allowCustom ? 'true' : 'false' ?>;
    var currencySymbol = '<?= $escaper->escapeJs($block->getCurrencySymbol()) ?>';

    function formatFallback(num) {
        if (isNaN(num)) {
            return '';
        }
        return currencySymbol + Number(num).toFixed(2);
    }

    function updatePdpPriceDisplay(raw, formatted) {
        // Update Magento PDP price markup (your theme uses the standard priceBox structure).
        var $priceBox = $form.closest('.product-info-main').find('[data-role=priceBox]').first();
        if (!$priceBox.length) {
            $priceBox = $form.find('[data-role=priceBox]').first();
        }
        if (!$priceBox.length) {
            return;
        }

        var productId = String($priceBox.data('product-id') || '');
        var $wrapper = productId
            ? $('#product-price-' + productId)
            : $priceBox.find('[data-price-type="finalPrice"]').first();
        if (!$wrapper.length) {
            $wrapper = $priceBox.find('[data-price-type="finalPrice"]').first();
        }

        // Text shown to customer.
        var $priceText = $wrapper.find('.price').first();
        if ($priceText.length) {
            $priceText.text(formatted);
        }

        // Keep underlying amount in sync.
        $wrapper.attr('data-price-amount', String(raw));
        $priceBox.find('meta[itemprop="price"]').attr('content', String(raw));
    }

    function setAmount(num, formatted) {
        if (isNaN(num) || num < min || num > max) {
            return;
        }
        $hidden.val(num);
        updatePdpPriceDisplay(num, formatted);
    }

    $wrap.on('click', '.venbhas-giftcard-preset', function () {
        $wrap.find('.venbhas-giftcard-preset').removeClass('active');
        $(this).addClass('active');
        $otherWrap.hide();
        var amt = parseFloat($(this).data('amount'));
        var formatted = $(this).data('formatted') || String(amt);
        setAmount(amt, formatted);
    });

    $wrap.on('click', '.venbhas-giftcard-other', function () {
        if (!allowCustom) {
            return;
        }
        $wrap.find('.venbhas-giftcard-preset').removeClass('active');
        $otherWrap.show();
        $otherInput.trigger('focus');
    });

    $otherInput.on('change input', function () {
        var v = parseFloat($(this).val());
        if (isNaN(v)) {
            return;
        }
        setAmount(v, formatFallback(v));
    });

    var offerAddress = <?= $offerPhysicalAddress ? 'true' : 'false' ?>;
    var deliveryBothMode = <?= ($deliveryType === $deliveryBoth) ? 'true' : 'false' ?>;
    var physicalDeliveryValue = '<?= $escaper->escapeJs($deliveryPhysical) ?>';

    function setGiftcardAddressVisible(show) {
        var $addr = $('#venbhas_giftcard_address_wrap');
        if (!$addr.length) {
            return;
        }
        var $inputs = $addr.find('.venbhas-gc-addr-input');
        if (show) {
            $addr.show();
            $inputs.prop('disabled', false).prop('required', true);
        } else {
            $addr.hide();
            $inputs.prop('disabled', true).prop('required', false).val('');
        }
    }

    var virtualDeliveryLabel = '<?= $escaper->escapeJs(__('Email / virtual delivery')) ?>';
    var physicalDeliveryLabel = '<?= $escaper->escapeJs(__('Physical delivery')) ?>';
    var selectedDeliveryPrefix = '<?= $escaper->escapeJs(__('Selected:')) ?> ';

    function updateDeliverySelectionLabel() {
        var $txt = $('#venbhas_giftcard_delivery_status_text');
        if (!$txt.length || !deliveryBothMode) {
            return;
        }
        var $checked = $form.find('input[name="venbhas_giftcard[delivery_type]"]:checked');
        var val = $checked.length ? String($checked.val()) : '';
        var label = val === physicalDeliveryValue ? physicalDeliveryLabel : virtualDeliveryLabel;
        $txt.text(selectedDeliveryPrefix + label);
    }

    if (offerAddress && deliveryBothMode) {
        $form.on('change', 'input[name="venbhas_giftcard[delivery_type]"]', function () {
            setGiftcardAddressVisible($(this).val() === physicalDeliveryValue);
            updateDeliverySelectionLabel();
        });
        var $checked = $form.find('input[name="venbhas_giftcard[delivery_type]"]:checked');
        setGiftcardAddressVisible($checked.length && $checked.val() === physicalDeliveryValue);
        updateDeliverySelectionLabel();
    }

    // Country/Region dropdowns like checkout (but keep text fields for existing backend storage)
    var $countryId = $('#venbhas_giftcard_delivery_country_id');
    var $countryText = $('#venbhas_giftcard_delivery_country');
    var $regionId = $('#venbhas_giftcard_delivery_region_id');
    var $regionText = $('#venbhas_giftcard_delivery_region');

    function syncCountryText() {
        if (!$countryId.length || !$countryText.length) {
            return;
        }
        var t = $countryId.find('option:selected').text() || '';
        $countryText.val($.trim(t));
    }

    function syncRegionTextFromSelect() {
        if (!$regionId.length || !$regionText.length) {
            return;
        }
        var t = $regionId.find('option:selected').text() || '';
        t = $.trim(t);
        // Skip placeholder option text
        if ($regionId.val() === '' || t.toLowerCase().indexOf('please select') === 0) {
            return;
        }
        $regionText.val(t);
    }

    if ($countryId.length) {
        // Populate regions based on selected country
        $countryId.directoryRegionUpdater({
            regionListId: '#venbhas_giftcard_delivery_region_id',
            regionInputId: '#venbhas_giftcard_delivery_region',
            postcodeId: '#venbhas_giftcard_delivery_postcode',
            form: '#product_addtocart_form',
            regionJson: <?= /* @noEscape */ $regionJsonForUpdater ?>,
            <?php
            $optionalZip = $directoryHelper
                ? $directoryHelper->getCountriesWithOptionalZip(true)
                : '[]';
            ?>
            countriesWithOptionalZip: <?= /* @noEscape */ $optionalZip ?>,
            defaultRegion: '',
            optionalRegionAllowed: true
        });

        $countryId.on('change', function () {
            syncCountryText();
            // Reset region text when country changes; region-updater will toggle/select as needed
            if ($regionText.length) {
                $regionText.val('');
            }
        });
        syncCountryText();
        // Ensure region dropdown is populated for the initially selected country
        $countryId.trigger('change');
    }

    if ($regionId.length) {
        $regionId.on('change', syncRegionTextFromSelect);
    }
});
</script>
