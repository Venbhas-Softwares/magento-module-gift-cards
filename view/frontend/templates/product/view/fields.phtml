<?php
/** @var \Venbhas\GiftCard\Block\Product\View\Fields $block */
if (!$block->shouldRender()) {
    return;
}
$presets = $block->getAmountPresets();
$defaultAmount = $presets[0] ?? $block->getMinAmount();
$allowCustom = $block->isCustomAmountAllowed();
$showOtherOnly = $presets === [] && $allowCustom;
$deliveryType = $block->getGiftDeliveryType();
$deliveryVirtual = \Venbhas\GiftCard\Model\Config::GIFT_DELIVERY_VIRTUAL;
$deliveryPhysical = \Venbhas\GiftCard\Model\Config::GIFT_DELIVERY_PHYSICAL;
$deliveryBoth = \Venbhas\GiftCard\Model\Config::GIFT_DELIVERY_BOTH;
$allowMessage = $block->isCustomMessageAllowed();
$offerPhysicalAddress = $block->isPhysicalDeliveryOffered();
$addressVisibleInitially = $offerPhysicalAddress && ($deliveryType === $deliveryPhysical);
$directoryBlock = $block->getLayout()->createBlock(\Magento\Directory\Block\Data::class);
$directoryHelper = $block->getDirectoryHelper();

// Build region JSON compatible with `Magento_Directory/js/region-updater` (expects `id` inside each region node).
$regionJsonForUpdater = '{}';
try {
    $base = json_decode((string) $directoryHelper->getRegionJson(), true);
    $regionsOnly = json_decode((string) $directoryBlock->getRegionsJs(), true);
    if (is_array($base) && is_array($regionsOnly)) {
        foreach ($regionsOnly as $countryId => $regions) {
            if (!is_array($regions)) {
                continue;
            }
            foreach ($regions as $regionId => $regionData) {
                if (!is_array($regionData)) {
                    $regionData = [];
                }
                $base[$countryId][$regionId] = [
                    'id' => (int) $regionId,
                    'code' => (string) ($regionData['code'] ?? ''),
                    'name' => (string) ($regionData['name'] ?? ''),
                ];
            }
        }
        $regionJsonForUpdater = json_encode($base) ?: '{}';
    }
} catch (\Throwable) {
    $regionJsonForUpdater = '{}';
}
