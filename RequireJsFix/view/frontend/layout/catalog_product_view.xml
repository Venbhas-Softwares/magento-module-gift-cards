<?xml version="1.0"?>
<!--
    Hyvä default theme registers catalog.preload.product.gallery without imageHelper.
    catalog-preload-product-gallery.phtml falls back to getDefaultPlaceholderUrl() when
    there is no main image, which errors if imageHelper is missing.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalog.preload.product.gallery">
            <arguments>
                <argument name="imageHelper" xsi:type="object">Magento\Catalog\Helper\Image</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
